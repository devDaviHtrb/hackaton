# ==========================================
# HACKATHON APP - ENVIRONMENT CONFIGURATION
# ==========================================

# Flask & Server
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-me-to-a-super-secret-random-key
FERNET_KEY=

# Database (SQLAlchemy)
# Default is SQLite for zero-setup out of the box:
SQLALCHEMY_DATABASE_URI=sqlite:///hackathon.db
# Or PostgreSQL for production:
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@localhost:5432/hackathon

# Cache
CACHE_TYPE=SimpleCache
# CACHE_TYPE=RedisCache
# CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TIMEOUT=300

# WebSockets
SOCKETIO_ASYNC_MODE=threading

# Email (SMTP Gmail / Custom) - Optional: logs to console if empty
CORPORATION_EMAIL=
CORPORATION_PASSWORD=

# Google OAuth - Optional
GOOGLE_CLIENT_ID=
GOOGLE_SECRECT=
GOOGLE_PROJECT_ID=
GOOGLE_REDIRECT_URIS=http://localhost:5000/auth/google/validate
REDIRECT_URI=http://localhost:5000/auth/google/validate

# Cloudinary (Image Uploads) - Optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demografix (Genderize.io) - estimativa probabilística de gênero por nome
DEMOGRAFIX_API_KEY=

# OpenAlex - opcional (deixe vazio para o pool anonimo / mailto)
OPENALEX_API_KEY=

# PostgreSQL (usado pelo docker compose)
# Em dev, estes valores default ja funcionam. Em producao, troque a senha.
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_DB=hackathon
POSTGRES_PORT=5432
